    <style>
      .image-upload-container {
        margin: 20px auto;
        max-width: 500px;
      }
      
      .image-preview {
        width: 100%;
        height: 250px;
        border: 2px dashed #0ef;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        background-color: rgba(0, 238, 255, 0.05);
        transition: all 0.3s ease;
      }
      
      .image-preview:hover {
        background-color: rgba(0, 238, 255, 0.1);
        border-color: rgba(0, 238, 255, 0.8);
      }
      
      .image-preview img {
        max-width: 100%;
        max-height: 100%;
        display: none;
        border-radius: 8px;
        object-fit: contain;
      }
      
      .upload-label {
        display: inline-block;
        padding: 12px 20px;
        background: linear-gradient(45deg, #00bfff, #0ef);
        color: #0F172A;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
        margin-bottom: 10px;
        text-align: center;
        min-width: 150px;
      }
      
      .upload-label:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 25px rgba(0, 238, 255, 0.8);
      }
      
      .file-input {
        display: none;
      }
      
      .prediction-result {
        margin-top: 20px;
        padding: 25px;
        border-radius: 15px;
        background: rgba(0, 0, 0, 0.4);
        border: 3px solid #0ef;
        text-align: center;
        box-shadow: 0 0 20px rgba(0, 238, 255, 0.3);
        animation: glow 2s infinite alternate;
      }
      
      @keyframes glow {
        from {
          box-shadow: 0 0 10px rgba(0, 238, 255, 0.3);
        }
        to {
          box-shadow: 0 0 20px rgba(0, 238, 255, 0.6);
        }
      }
      
      .prediction-result h3 {
        color: #0ef;
        margin-bottom: 15px;
        font-size: 22px;
        font-weight: 600;
        text-shadow: 0 0 10px rgba(0, 238, 255, 0.5);
      }
      
      .risk-meter {
        width: 100%;
        height: 30px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 15px;
        margin: 20px 0;
        position: relative;
        overflow: hidden;
        box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);
      }
      
      .risk-level {
        height: 100%;
        background: linear-gradient(45deg, #00ff00, #ffff00, #ff0000);
        width: 0%;
        transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1);
      }
      
      .risk-percentage {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        color: white;
        font-weight: bold;
        font-size: 16px;
        text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.8);
      }
      
      .loader {
        border: 5px solid rgba(0, 238, 255, 0.3);
        border-radius: 50%;
        border-top: 5px solid #0ef;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
        margin: 20px auto;
        display: none;
      }
      
      @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
      }
      
      .upload-info {
        color: rgba(255, 255, 255, 0.7);
        text-align: center;
        margin-top: 10px;
        font-size: 14px;
      }
      
      .drag-text {
        color: #0ef;
        font-size: 20px;
        font-weight: 500;
        text-align: center;
        padding: 0 15px;
      }
      
      .recommendation {
        background-color: rgba(0, 238, 255, 0.1);
        padding: 12px 15px;
        border-radius: 8px;
        margin-top: 15px;
        border-left: 3px solid #0ef;
        text-align: left;
        color: #fff;
      }
      
      .analyzed-image {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid rgba(0, 238, 255, 0.3);
      }
      
      .analyzed-image h4 {
        color: #0ef;
        margin-bottom: 10px;
      }
      
      .error-message {
        color: #ff6b6b;
        background-color: rgba(255, 107, 107, 0.1);
        padding: 10px;
        border-radius: 5px;
        margin: 10px 0;
        border-left: 3px solid #ff6b6b;
      }
      
      /* Responsive adjustments */
      @media (max-width: 768px) {
        .bg-text {
          width: 90%;
          transform: translate(-50%, -50%);
        }
        
        .bg-text1 {
          width: 90%;
          transform: translate(-50%, -50%);
        }
      }
    </style>
