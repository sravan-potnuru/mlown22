    <script>
      // Modified form submission handler
      document.addEventListener('DOMContentLoaded', function() {
        // Set up the form submit button
        const submitBtn = document.getElementById('submitBtn');
        if (submitBtn) {
          submitBtn.addEventListener('click', function() {
            const fileInput = document.getElementById('retinalImage');
            let errorMessageElement = document.getElementById('errorMessage');
            const loader = document.getElementById('loader');
            
            // Create error message element if it doesn't exist
            if (!errorMessageElement) {
              errorMessageElement = document.createElement('div');
              errorMessageElement.id = 'errorMessage';
              errorMessageElement.className = 'error-message';
              const uploadContainer = document.querySelector('.image-upload-container');
              uploadContainer.insertBefore(errorMessageElement, uploadContainer.firstChild);
            }
            
            // Validate file selection
            if (fileInput.files.length === 0) {
              errorMessageElement.innerHTML = '<p class="error">Please select an image to upload</p>';
              errorMessageElement.style.display = 'block';
              return;
            }
            
            // Create FormData object
            const formData = new FormData();
            formData.append('retinalImage', fileInput.files[0]);
            
            // Show loader, hide button
            loader.style.display = 'block';
            submitBtn.style.display = 'none';
            errorMessageElement.style.display = 'none';
            
            // Submit the form
            const form = document.getElementById('uploadForm');
            form.method = 'POST';
            form.action = '/retinal';
            form.enctype = 'multipart/form-data';
            form.submit();
          });
        }
        
        // Handle risk level display if prediction exists
        const riskLevel = document.getElementById('riskLevel');
        if (riskLevel) {
          // Get the percentage from the prediction_result
          const percentage = document.querySelector('.risk-percentage').textContent;
          console.log("Setting risk level width to:", percentage);
          
          // Small delay for animation effect
          setTimeout(() => {
            riskLevel.style.width = percentage;
          }, 500);
        }
        
        // Image preview functionality
        const fileInput = document.getElementById('retinalImage');
        const previewImg = document.getElementById('previewImg');
        const imagePreview = document.getElementById('imagePreview');
        const dragText = document.getElementById('dragText');
        
        if (fileInput) {
          fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
              // Check file size (max 5MB)
              if (file.size > 5 * 1024 * 1024) {
                alert('File size exceeds 5MB. Please choose a smaller file.');
                this.value = '';
                return;
              }
              
              // Check file type
              const fileType = file.type;
              if (!fileType.match('image/jpeg') && !fileType.match('image/png')) {
                alert('Please upload a valid image file (JPG, JPEG, or PNG).');
                this.value = '';
                return;
              }
              
              const reader = new FileReader();
              
              reader.addEventListener('load', function() {
                previewImg.setAttribute('src', this.result);
                previewImg.style.display = 'block';
                dragText.style.display = 'none';
              });
              
              reader.readAsDataURL(file);
            }
          });
        }
        
        // Drag and drop functionality
        if (imagePreview) {
          imagePreview.addEventListener('dragover', function(e) {
            e.preventDefault();
            this.style.borderStyle = 'solid';
            this.style.backgroundColor = 'rgba(0, 238, 255, 0.2)';
            dragText.textContent = 'Release to Upload';
          });
          
          imagePreview.addEventListener('dragleave', function() {
            this.style.borderStyle = 'dashed';
            this.style.backgroundColor = 'rgba(0, 238, 255, 0.05)';
            dragText.textContent = 'Drag and drop retinal image here or click to upload';
          });
          
          imagePreview.addEventListener('drop', function(e) {
            e.preventDefault();
            this.style.borderStyle = 'dashed';
            this.style.backgroundColor = 'rgba(0, 238, 255, 0.05)';
            
            const file = e.dataTransfer.files[0];
            if (file) {
              // Check file size (max 5MB)
              if (file.size > 5 * 1024 * 1024) {
                alert('File size exceeds 5MB. Please choose a smaller file.');
                return;
              }
              
              // Check file type
              const fileType = file.type;
              if (!fileType.match('image/jpeg') && !fileType.match('image/png')) {
                alert('Please upload a valid image file (JPG, JPEG, or PNG).');
                return;
              }
              
              fileInput.files = e.dataTransfer.files;
              
              const reader = new FileReader();
              reader.addEventListener('load', function() {
                previewImg.setAttribute('src', this.result);
                previewImg.style.display = 'block';
                dragText.style.display = 'none';
              });
              
              reader.readAsDataURL(file);
            }
          });
          
          // Click to upload
          imagePreview.addEventListener('click', function() {
            fileInput.click();
          });
        }
        
        // Display error message if present
        const errorMessage = document.querySelector('.error-message');
        if (errorMessage && errorMessage.textContent.trim() !== '') {
          errorMessage.style.display = 'block';
          
          // Auto-hide error message after 5 seconds
          setTimeout(() => {
            errorMessage.style.opacity = '0';
            setTimeout(() => {
              errorMessage.style.display = 'none';
            }, 500);
          }, 5000);
        }
      });
      </script>
