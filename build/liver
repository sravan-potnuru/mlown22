    <div class="bg-text">
        <form action="/liver" method="post">
          <div class="container">
            <input type="text" step="any" name="AGE" required="" class="input" />
            <label class="label" for="AGE">AGE:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Total_Bilirubin" required="" class="input" />
            <label class="label" for="Total_Bilirubin">Total_Bilirubin:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Direct_Bilirubin" required="" class="input" />
            <label class="label" for="Direct_Bilirubin">Direct_Bilirubin:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Alkaline_Phosphotase" required="" class="input" />
            <label class="label" for="Alkaline_Phosphotase">Alkaline_Phosphotase:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Alamine_Aminotransferase" required="" class="input" />
            <label class="label" for="Alamine_Aminotransferase">Alamine_Aminotransferase:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Aspartate_Aminotransferase" required="" class="input" />
            <label class="label" for="Aspartate_Aminotransferase">Aspartate_Aminotransferase:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Total_Protiens" required="" class="input" />
            <label class="label" for="Total_Protiens">Total_Protiens:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Albumin" required="" class="input" />
            <label class="label" for="Albumin">Albumin:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Albumin_and_Globulin_Ratio" required="" class="input" />
            <label class="label" for="Albumin_and_Globulin_Ratio">Albumin_and_Globulin_Ratio:</label>
          </div>
          <div class="container">
            <input type="text" step="any" name="Gender_Male" required="" class="input" />
            <label class="label" for="Gender_Male">GENDER:</label>
          </div>
          <div class="container">
              <input type="submit" value="Submit" class="button" />
          </div>
        </form>
